{
  "name": "dsh-ui-enhance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH sidebar and copy enhancements: foldable Projects / Sessions areas, standalone-session new button, and editable Chinese UI copy overrides.",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts test package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check src scripts test package.json tsconfig.json .prettierrc.json",
    "check": "npm run typecheck && npm run format:check && npm test",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
